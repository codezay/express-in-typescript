{
  "name": "api-basic-lesson",
  "version": "1.0.0",
  "description": "api basics in typescript using express",
  "license": "ISC",
  "author": "codezay",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev-": "nodemon --exec tsx src/server.ts",
    "dev": "nodemon --exec tsx --watch src --ext ts src/server.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "rm -rf build/ && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "express": "^5.2.1"
  }
}
